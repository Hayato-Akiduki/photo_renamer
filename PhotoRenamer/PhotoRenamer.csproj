<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10/11 に標準搭載のランタイムを使うので exe が小さく済む -->
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PhotoRenamer</AssemblyName>
    <RootNamespace>PhotoRenamer</RootNamespace>
    <ApplicationIcon>camera.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.1.0</Version>
    <!-- バージョン表示に git のコミット ID を付けない -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>写真・動画リネーマー</Product>
    <AssemblyTitle>写真・動画リネーマー</AssemblyTitle>
    <Copyright>Copyright © 2026</Copyright>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="camera.ico" />
    <Reference Include="Microsoft.VisualBasic" />
  </ItemGroup>

</Project>
